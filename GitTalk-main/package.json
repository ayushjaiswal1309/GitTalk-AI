{
  "name": "git-talk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm run build --prefix Frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix Frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "dev:app": "cd app && ../venv/bin/uvicorn server:app --reload --host 127.0.0.1 --port 8000",
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:app\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
